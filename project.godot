; Engine configuration file.
; Dragon Bowling — versão TV Box S905L (Android 7.1, Mali-450, Godot 3.6).
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "CanvasLayer",
"class": "Cortina",
"language": "GDScript",
"path": "res://scripts/cortina.gd"
} ]
_global_script_class_icons={
"Cortina": ""
}

[application]

config/name="Dragon Bowling"
config/description="Dragon Bowling - TV Box S905L (Android 7.1)"
run/main_scene="res://scene/abertura.tscn"
boot_splash/image="res://sprites/marca/splash_giro_1.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://sprites/icone_dragon_bowling_exe.png"
config/quit_on_go_back=false

[audio]

default_bus_layout=""

[autoload]

Compat="*res://scripts/compat_g3.gd"
Tela="*res://autoload/Tela.gd"
MusicManager="*res://scripts/music_manager.gd"
GameConfig="*res://autoload/GameConfig.gd"
ArduinoBridge="*res://autoload/ArduinoBridge.gd"
ArcadeControls="*res://autoload/ArcadeControls.gd"

[display]

window/size/width=1536
window/size/height=1024
window/size/fullscreen=true
window/handheld/orientation="sensor_landscape"
window/stretch/mode="2d"
window/stretch/aspect="ignore"
window/energy_saving/keep_screen_on=true

[dragon]

tela/giro=1

[gui]

theme/custom_font="res://fonts/padrao_g3.tres"
common/drop_mouse_on_gui_input_disabled=true

